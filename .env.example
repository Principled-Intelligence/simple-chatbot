# Provider keys used by LiteLLM-backed models.
OPENAI_API_KEY=

# Hosted ScopeGuard API key. Used only when ScopeGuard is enabled with the
# default api backend and --guard-api-url is not set.
ORBITALS_API_KEY=

# Optional API key required by simple-chatbot's /v1/chat/completions endpoint.
# Set this when binding the server to a network interface.
SIMPLE_CHATBOT_API_KEY=

# Optional smoke-test target. The smoke test defaults to http://localhost:15077
# when BASE_URL is not set.
BASE_URL=http://localhost:8000
